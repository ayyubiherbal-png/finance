# Salin file ini menjadi .env.test lalu isi dari project Supabase KHUSUS TESTING
# (bukan project produksi!) -- Project Settings > API.
#
# Kenapa harus project terpisah: suite E2E ini membuat, mengubah, dan MENGHAPUS
# data sungguhan lewat RPC/tabel yang sama seperti aplikasi (SO, faktur, stok,
# kas) sebagai bagian dari seeding & cleanup antar test. Menjalankannya lawan
# project produksi bisa mengotori/menghapus data bisnis Anda yang sebenarnya.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx-test.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kredensial akun staf yang SUDAH ADA di project test di atas -- dipakai auth
# fixture (e2e/fixtures/auth.ts) supaya test yang perlu login tidak mengulang
# proses login manual tiap kali jalan. Buat 1 user per peran yang mau dites
# (minimal 'owner' atau 'admin'; tambah 'sales'/'gudang'/'finance' kalau ada
# journey yang butuh uji batasan otorisasi antar peran).
E2E_EMAIL_OWNER=owner@test.local
E2E_PASSWORD_OWNER=ganti-ini
E2E_EMAIL_SALES=sales@test.local
E2E_PASSWORD_SALES=ganti-ini
